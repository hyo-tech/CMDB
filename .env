# =============================================================================
# HYO ITOM 社区版配置文件
# -----------------------------------------------------------------------------
# 本文件为社区版安装包的 .env 模板（精简版，仅含 docker-compose 实际需要的变量）。
# 安装脚本 scripts/install.sh 运行时会将本文件复制为 .env，并把 <host_FQDN>
# 占位符替换为您传入的主机名。
#
# ⚠ 修改后需重新执行：docker compose up -d
# =============================================================================

# ─── 访问地址 ─────────────────────────────────────────────────────────────────
# <host_FQDN>：安装时由 install.sh 替换为您传入的完整域名（如 app.yourcompany.com）
#              必须通过域名访问，不能使用 IP；详见 README「安装步骤」。
HOST=<host_FQDN>

# 社区版固定对外端口 443（https 默认端口，浏览器访问免显式 :443）
WEBSECURE_PORT=443

# 应用路径前缀（UI/API/IDM 均挂在此路径下，如 https://<host>/itom/ui/...）
CONTEXT_PATH=/itom

# ─── Docker Compose ──────────────────────────────────────────────────────────
# 容器编排项目名（决定容器/网络/卷的命名前缀）
COMPOSE_PROJECT_NAME=cmdb

# ─── 租户 ─────────────────────────────────────────────────────────────────────
# 社区版默认租户 ID
DEFAULT_TENANT_ID=100000001

# ─── 数据库 ───────────────────────────────────────────────────────────────────
POSTGRES_DB=hyo_itom
POSTGRES_USER=postgres
POSTGRES_PASSWORD=agens

# ─── 安全密钥（社区版开箱即用默认值） ─────────────────────────────────────────
# 生产环境建议重新生成后再首次安装；⚠ 一旦写入数据后不可更换，否则历史密文无法解密。

# 字段级国密加密主密钥（SM4-128）：32 个 hex 字符（16 字节）。
# 用于数据库敏感字段（密码/API key/私钥等）的静态加密。
# 生成：openssl rand -hex 16
FIELD_ENCRYPTION_MASTER_KEY=d91eeac816b61258f9e58f6410e39fd2

# ForwardAuth 会话 Cookie 加密密钥（64 个 hex 字符）
# 生成：openssl rand -hex 32
FORWARDAUTH_COOKIE_SECRET=4f4a35bd35ba23614173cde64cda8a8574b1671fcc0cf6700bfb1bcb6cda3e6c
FORWARDAUTH_ENCRYPTION_KEY=a159fc4dc894e51a38bb697554d18de7b54c04acad8124027f398e85d4351ef7

# UI 服务 CSRF 防护 Token 密钥（32 字节）
# 生成：openssl rand -hex 32
CSRF_TOKEN_SECRET=change-this-to-a-secure-32-byte-secret-key-for-production

# ─── Keycloak 认证 ───────────────────────────────────────────────────────────
# 管理员与系统管理员初始密码（首次安装后可在 Keycloak 控制台修改）
KEYCLOAK_ADMIN_PASSWORD=Admin_1234
KEYCLOAK_SYSADMIN_PASSWORD=Sysadmin_1234

# 前端 UI 客户端（OIDC 授权码流程）
KEYCLOAK_CLIENT_ID=cmdb_ui
KEYCLOAK_CLIENT_SECRET=Zjg37xZfnALDJ9K9mc7fecFDxDLhl1Vf

# 后端服务账号客户端（client credentials，服务间调用）
KEYCLOAK_SERVICE_ACCOUNT_CLIENT_ID=cmdb_backend
KEYCLOAK_SERVICE_ACCOUNT_CLIENT_SECRET=W5XJKxS7zbWbIJyHuIdMIRVitu3cBssr

# ─── AI 助手模型配置 ─────────────────────────────────────────────────────────
# AI 助手（自然语言查询/对话）依赖外部大模型。以下三项「全部填写」才会启用 AI 助手；
# 留空则 AI 助手不可用（不影响 CMDB 核心功能）。详见 README「AI 助手模型配置」。
#
# 常见供应商示例：
#   MiniMax：  NAME=MiniMax-M3   BASE_URL=https://api.minimaxi.com/v1
#   OpenAI：   NAME=gpt-4o       BASE_URL=https://api.openai.com/v1
#   智谱 GLM： NAME=glm-4        BASE_URL=https://open.bigmodel.cn/api/paas/v4
ITOM_MODEL_NAME=
ITOM_MODEL_BASE_URL=
ITOM_MODEL_API_KEY=

# ─── AI 辅助任务模型（可选，留空回退到上方主模型） ─────────────────────────────
# 以下为成本优化项：可为不同任务指定更便宜的模型。留空则统一使用主模型。

# 记忆抽取（结构化输出）
ITOM_MEMORY_EXTRACT_MODEL=
ITOM_MEMORY_EXTRACT_BASE_URL=
ITOM_MEMORY_EXTRACT_API_KEY=
# 记忆规划（阻塞任务，影响首字延迟）
ITOM_MEMORY_PLANNER_MODEL=
ITOM_MEMORY_PLANNER_BASE_URL=
ITOM_MEMORY_PLANNER_API_KEY=

# 工件功能总开关（默认关闭，设为 true 启用）
ITOM_ARTIFACT_ENABLED=false
ITOM_ARTIFACT_MODEL=
ITOM_ARTIFACT_BASE_URL=
ITOM_ARTIFACT_API_KEY=

# 语义 PII 检测（作为正则层的补充，默认启用）
ITOM_PII_LLM_ENABLED=true
ITOM_PII_LLM_MODEL=
ITOM_PII_LLM_BASE_URL=
ITOM_PII_LLM_API_KEY=
