http:
  routers:
    # dev-ui 主路由 - UI 层认证由 ProtectedRoute 处理
    dev-ui:
      rule: "PathPrefix(`/ui1`)"
      service: dev-ui
      entryPoints:
        - "websecure"
      tls: {}
      priority: 100

    cmdb-dev-api-bearer:
      rule: "PathPrefix(`/api1/100000001/cmdb`)  && HeaderRegexp(`Authorization`, `^Bearer .+`)"
      service: cmdb-dev-api
      entryPoints:
        - "websecure"
      tls: {}
      priority: 100

    cmdb-dev-api:
      rule: "PathPrefix(`/api1/100000001/cmdb`)"
      service: cmdb-dev-api
      entryPoints:
        - "websecure"
      tls: {}
      priority: 90
      middlewares:
        - oauth2-proxy@docker

    monitoring-dev-api-bearer:
      rule: "PathPrefix(`/api1/100000001/monitoring`)  && HeaderRegexp(`Authorization`, `^Bearer .+`)"
      service: monitoring-dev-api
      entryPoints:
        - "websecure"
      tls: {}
      priority: 100

    monitoring-dev-api:
      rule: "PathPrefix(`/api1/100000001/monitoring`)"
      service: monitoring-dev-api
      entryPoints:
        - "websecure"
      tls: {}
      priority: 90
      middlewares:
        - oauth2-proxy@docker

    platform-dev-api-bearer:
      rule: "PathPrefix(`/api1/100000001/platform`)  && HeaderRegexp(`Authorization`, `^Bearer .+`)"
      service: platform-dev-api
      entryPoints:
        - "websecure"
      tls: {}
      priority: 100

    platform-dev-api:
      rule: "PathPrefix(`/api1/100000001/platform`)"
      service: platform-dev-api
      entryPoints:
        - "websecure"
      tls: {}
      priority: 90
      middlewares:
        - oauth2-proxy@docker

    search-dev-api-bearer:
      rule: "PathPrefix(`/api1/100000001/search`)  && HeaderRegexp(`Authorization`, `^Bearer .+`)"
      service: search-dev-api
      entryPoints:
        - "websecure"
      tls: {}
      priority: 100

    search-dev-api:
      rule: "PathPrefix(`/api1/100000001/search`)"
      service: search-dev-api
      entryPoints:
        - "websecure"
      tls: {}
      priority: 90
      middlewares:
        - oauth2-proxy@docker


  services:
    dev-ui:
      loadBalancer:
        servers:
          - url: "https://laptop-og3ftb1r:8000"
        passHostHeader: true
        serversTransport: dev-transport

    dev-classmodel-ui:
      loadBalancer:
        servers:
          - url: "https://laptop-og3ftb1r:8002"
        passHostHeader: true
        serversTransport: dev-transport

    cmdb-dev-api:
      loadBalancer:
        servers:
          - url: "https://laptop-og3ftb1r:8100"
        passHostHeader: true
        serversTransport: dev-transport

    monitoring-dev-api:
      loadBalancer:
        servers:
          - url: "https://laptop-og3ftb1r:8102"
        passHostHeader: true
        serversTransport: dev-transport

    platform-dev-api:
      loadBalancer:
        servers:
          - url: "https://laptop-og3ftb1r:8101"
        passHostHeader: true
        serversTransport: dev-transport                                        

    search-dev-api:
      loadBalancer:
        servers:
          - url: "https://laptop-og3ftb1r:8103"
        passHostHeader: true
        serversTransport: dev-transport  

  serversTransports:
    dev-transport:
      insecureSkipVerify: true

