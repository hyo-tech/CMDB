http:
  routers:
    # Public authenticate endpoint - no oauth2-proxy
    platform-auth:
      rule: "PathRegexp(`^/api/[0-9]+/platform/authenticate`)"
      service: platform-dev-api
      entryPoints:
        - "websecure"
      tls: {}
      priority: 110

    # dev-ui 主路由 - UI 层认证由 ProtectedRoute 处理
    dev-ui:
      rule: "PathPrefix(`/ui1`)"
      service: dev-ui
      entryPoints:
        - "websecure"
      tls: {}
      priority: 100

    cmdb-dev-api-bearer:
      rule: "PathPrefix(`/api/100000001/cmdb`)  && HeaderRegexp(`Authorization`, `^Bearer .+`)"
      service: cmdb-dev-api
      entryPoints:
        - "websecure"
      tls: {}
      priority: 100

    cmdb-dev-api:
      rule: "PathPrefix(`/api/100000001/cmdb`)"
      service: cmdb-dev-api
      entryPoints:
        - "websecure"
      tls: {}
      priority: 90

    monitoring-dev-api-bearer:
      rule: "PathPrefix(`/api/100000001/monitoring`)  && HeaderRegexp(`Authorization`, `^Bearer .+`)"
      service: monitoring-dev-api
      entryPoints:
        - "websecure"
      tls: {}
      priority: 100

    monitoring-dev-api:
      rule: "PathPrefix(`/api/100000001/monitoring`)"
      service: monitoring-dev-api
      entryPoints:
        - "websecure"
      tls: {}
      priority: 90

    platform-dev-api-bearer:
      rule: "PathPrefix(`/api/100000001/platform`)  && HeaderRegexp(`Authorization`, `^Bearer .+`)"
      service: platform-dev-api
      entryPoints:
        - "websecure"
      tls: {}
      priority: 100

    platform-dev-api:
      rule: "PathPrefix(`/api/100000001/platform`) && !PathRegexp(`^/api/[0-9]+/platform/authenticate`)"
      service: platform-dev-api
      entryPoints:
        - "websecure"
      tls: {}
      priority: 90

    search-dev-api-bearer:
      rule: "PathPrefix(`/api/100000001/search`)  && HeaderRegexp(`Authorization`, `^Bearer .+`)"
      service: search-dev-api
      entryPoints:
        - "websecure"
      tls: {}
      priority: 100

    search-dev-api:
      rule: "PathPrefix(`/api/100000001/search`)"
      service: search-dev-api
      entryPoints:
        - "websecure"
      tls: {}
      priority: 90

  services:
    dev-ui:
      loadBalancer:
        servers:
          - url: "https://laptop-og3ftb1r:8000"
        passHostHeader: true
        serversTransport: dev-transport

    dev-classmodel-ui:
      loadBalancer:
        servers:
          - url: "https://laptop-og3ftb1r:8002"
        passHostHeader: true
        serversTransport: dev-transport

    cmdb-dev-api:
      loadBalancer:
        servers:
          - url: "https://laptop-og3ftb1r:8100"
        passHostHeader: true
        serversTransport: dev-transport

    monitoring-dev-api:
      loadBalancer:
        servers:
          - url: "https://laptop-og3ftb1r:8102"
        passHostHeader: true
        serversTransport: dev-transport
                    
    platform-dev-api:
      loadBalancer:
        servers:
          - url: "https://laptop-og3ftb1r:8101"
        passHostHeader: true
        serversTransport: dev-transport                    

    search-dev-api:
      loadBalancer:
        servers:
          - url: "https://laptop-og3ftb1r:8103"
        passHostHeader: true
        serversTransport: dev-transport  

  serversTransports:
    dev-transport:
      insecureSkipVerify: true

