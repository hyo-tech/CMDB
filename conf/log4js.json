{
  "appenders": {
    "file": {
      "type": "file",
      "filename": "logs/cmdb.log",
      "maxLogSize": 10485760,
      "backups": 3,
      "compress": false
    },
    "out": {
      "type": "stdout"
    }
  },
  "categories": {
    "default": {
      "appenders": ["file", "out"],
      "level": "info"
    }
  }
}
